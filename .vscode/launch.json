{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server: dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:server",
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Client: dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev:client",
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "name": "Server: built (local single-origin)",
      "type": "node-terminal",
      "request": "launch",
      "command": "node apps/server/dist/index.js",
      "cwd": "${workspaceFolder}",
      "env": {
        "NODE_ENV": "production",
        "PORT": "8080",
        "STATIC_DIR": "${workspaceFolder}/apps/client/dist"
      }
    }
  ],
  "compounds": [
    {
      "name": "Start app (server + client)",
      "configurations": [
        "Server: dev",
        "Client: dev"
      ]
    },
    {
      "name": "Local deploy (built server)",
      "configurations": [
        "Server: built (local single-origin)"
      ]
    }
  ]
}
